from openai import OpenAI

client = OpenAI(api_key="ТВОЙ_API_КЛЮЧ")

text = """Мне сказали: выживешь в пяти раундах — станешь легендой. 
Сбежать нельзя. Правил нет. Это не игра. Это — эксперимент."""

audio = client.audio.speech.create(
    model="gpt-4o-mini-tts",
    voice="alloy",   # можно заменить на "verse" или "echo" для более киношного эффекта
    input=text
)

with open("legend_experiment.mp3", "wb") as f:
    f.write(audio.data)
